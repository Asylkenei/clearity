# Скопируйте в .env и задайте собственный ключ или запустите setup.ps1.
FORTE_API_KEY=replace-with-a-random-local-key
# start-public.ps1 creates a separate random key for the upload-only public app.
FORTE_PUBLIC_API_KEY=
# Enable the experimental visual review. Model server must run on 127.0.0.1:8081.
FORTE_MODEL_ENABLED=1
